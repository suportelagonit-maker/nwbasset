# NWB Asset — variaveis do docker-compose da raiz.
# Copie para .env e preencha. Este arquivo NAO contem segredos reais.
#
#   cp .env.example .env
#
# O .env do backend (backend/.env) continua existindo para rodar fora do Docker.
# Dentro do Docker, as variaveis abaixo tem precedencia sobre ele.

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
APP_ENV=local
APP_DEBUG=true
# Copie o valor de APP_KEY de backend/.env. Sem ele o Laravel nao inicia.
APP_KEY=
APP_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Banco de dados (container nwbasset-postgres)
# ---------------------------------------------------------------------------
DB_DATABASE=nwbasset
DB_USERNAME=nwbasset
# Obrigatoria. Gere uma senha forte e exclusiva deste sistema.
DB_PASSWORD=
# Porta publicada no host. 5432 a 5435 ja estao em uso nesta maquina.
DB_PORT_HOST=5436

# ---------------------------------------------------------------------------
# Portas publicadas
# ---------------------------------------------------------------------------
# Endereco em que as portas sao publicadas. 127.0.0.1 = so a propria maquina
# (obrigatorio na VPS, onde o Apache faz o proxy). 0.0.0.0 = toda a rede.
BIND_HOST=127.0.0.1
BACKEND_PORT=5000
FRONTEND_PORT=5001

# Logs do Laravel: stderr (recomendado no Docker) ou stack/single (arquivo).
LOG_CHANNEL=stderr
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Lida pelo NAVEGADOR e embutida no bundle durante o build da imagem.
# Precisa ser a URL publica da API, nao o nome do servico Docker.
# Local:    http://localhost:5000/api/v1
# Producao: https://api.seudominio.org.br/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# ---------------------------------------------------------------------------
# CAPTCHA (Cloudflare Turnstile)
# ---------------------------------------------------------------------------
# O login valida o Turnstile nos dois lados. Se ligar, o dominio de onde a
# aplicacao e servida precisa estar cadastrado no painel da Cloudflare,
# senao o login trava. Mantenha desligado enquanto roda so em localhost.
AUTH_CAPTCHA_ENABLED=false
NEXT_PUBLIC_LOGIN_CAPTCHA_ENABLED=0
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# NWB ID (Keycloak, realm nwb-equipe) + NWB Acessos — mesmo modelo do NCEdu
# ---------------------------------------------------------------------------
# Vazio = login pelo NWB ID desligado (so e-mail e senha). Ver docs/NWB-ID.md.
NWBID_ISSUER=
NWBID_CLIENTE=nwb-asset
NWBID_CLIENTES_ACEITOS=nwb-asset
NWBID_SISTEMA=nwb-asset
# Empresa (id) em que administradores do sistema no Acessos sao criados na 1a entrada.
NWBID_EMPRESA_ADMIN_ID=
# Conta de servico (cliente confidencial nwb-asset-api) para perguntar ao Acessos quem administra.
NWBID_ACESSOS_API_URL=https://acessos.igrejanovoscomecos.com.br
NWBID_ACESSOS_CLIENT_ID=nwb-asset-api
NWBID_ACESSOS_CLIENT_SECRET=
# Desligar (false) quando o NWB ID estiver configurado: entrada so pelo cracha unico.
AUTH_LOGIN_SENHA=true
